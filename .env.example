# ---------------------------------------------------------------------------
# LLM provider — pick ONE. The tool only needs an LLM for the extraction step;
# all financial data comes from the SEC for free.
# ---------------------------------------------------------------------------

# Provider selector:
#   auto          -> OpenAI key if set, else Anthropic key if set, else Codex CLI
#   openai        -> OpenAI platform API (native JSON-schema structured output)
#   openai-compat -> any OpenAI-compatible endpoint (DeepSeek, Groq, OpenRouter,
#                    Ollama, LM Studio, vLLM, ...) via OPENAI_BASE_URL
#   anthropic     -> Anthropic Claude (tool-use structured output)
#   codex         -> your ChatGPT account via the Codex CLI (no API key)
LLM_PROVIDER=auto

# --- OpenAI / OpenAI-compat ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Only needed for LLM_PROVIDER=openai-compat (e.g. https://api.openai.com/v1,
# https://api.anthropic.com/v1, http://localhost:11434/v1 for Ollama, ...)
OPENAI_BASE_URL=

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Codex (ChatGPT account) ---
# Optional explicit model (blank = use the account default).
CODEX_MODEL=

# SEC requests must carry a descriptive User-Agent (name + email).
SEC_USER_AGENT=Comps Scrubber contact@example.com
